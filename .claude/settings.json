{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(az account show:*)",
      "Bash(az group list:*)",
      "Bash(az group show:*)",
      "Bash(az resource list:*)",
      "Bash(az deployment group what-if:*)"
    ],
    "deny": [
      "Read(./.data/**)",
      "Read(./outputs/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"", "timeout": 45 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-cloud-changes.mjs\"", "timeout": 10 }
        ]
      }
    ]
  }
}
